# Auth
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/inventory_system

# App
NEXT_PUBLIC_APP_NAME=InvSys
# Business calendar used to resolve "today" and "this month" in reporting.
# Timestamps are always stored in UTC.
NEXT_PUBLIC_BUSINESS_TIMEZONE=Africa/Freetown

# Display currency. SLE is the new leone (post-2022 redenomination); do not use
# SLL, which formats without a symbol and means amounts 1000x larger.
# Amounts are stored as plain decimals, so changing this only affects display.
NEXT_PUBLIC_CURRENCY=SLE
NEXT_PUBLIC_CURRENCY_LOCALE=en-SL

# Shown on printed and PDF receipts. Distinct from the InvSys app name.
NEXT_PUBLIC_BUSINESS_NAME=Ram Jalloh
NEXT_PUBLIC_BUSINESS_PHONE=

# Where uploaded product photos are written. Must be writable and, in
# production, on a volume that survives redeploys.
UPLOAD_DIR=./storage/uploads
